# API URL reachable from the device; 10.0.2.2 maps Android emulator to the host.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# Public OAuth client identifiers (not secrets). The Web ID must also be in the
# API's GOOGLE_AUTH_CLIENT_IDS allowlist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Must be 1-30 and no greater than the API's TELEMETRY_ERROR_RETENTION_DAYS.
EXPO_PUBLIC_TELEMETRY_ERROR_OUTBOX_TTL_DAYS=7
